# ===========================================================================
# Nexus Alpha 환경변수 템플릿 (PR #104)
# ===========================================================================
# install.ps1 이 `.env` 가 없으면 본 파일을 복사합니다.
# 그 후 *로컬* .env 에서 실제 값을 채우세요 — git 에 절대 commit 금지.
# ===========================================================================

# ---- LLM Provider 선택 ----
# agent_sdk : Claude MAX 구독 사용 (기본, 무료) — Claude Code CLI 로그인 필요
# api_key   : Anthropic API Key 사용 (별도 과금)
LLM_PROVIDER=agent_sdk

# ---- 레거시 플래그 (기존 hello_agent.py 호환용) ----
# true 면 ANTHROPIC_API_KEY 사용, false 면 agent_sdk
USE_API_KEY=false

# ---- Anthropic API Key (LLM_PROVIDER=api_key 일 때만 필수) ----
# 발급: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-<your-key-here>

# ===========================================================================
# LangFuse 모니터링 (선택)
# ===========================================================================
# 가입 + 키 발급: https://cloud.langfuse.com → Settings → API Keys
# 두 키 모두 비어 있으면 모니터링 자동 비활성 (기능 영향 없음).
LANGFUSE_PUBLIC_KEY=pk-lf-<your-public-key>
LANGFUSE_SECRET_KEY=sk-lf-<your-secret-key>

# Self-hosted LangFuse 사용 시 변경 (기본: Cloud)
LANGFUSE_HOST=https://cloud.langfuse.com

# ===========================================================================
# (선택) Track B GitHub 발행 — gh CLI 가 PR/release 발행에 사용
# ===========================================================================
# gh auth login --web 으로 인증 권장. 환경변수로도 가능:
# GH_TOKEN=ghp_<your-personal-access-token>
